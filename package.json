{
  "name": "dual-mind",
  "displayName": "DualMind",
  "description": "%description%",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=24.0.0 <25.0.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dualMind.openWorkbench",
        "title": "%openWorkbench%",
        "category": "DualMind",
        "icon": "$(open-preview)"
      },
      {
        "command": "dualMind.showStatus",
        "title": "%showStatus%",
        "category": "DualMind"
      },
      {
        "command": "dualMind.newTask",
        "title": "%newTaskCommand%",
        "category": "DualMind",
        "icon": "$(add)"
      },
      {
        "command": "dualMind.selectTask",
        "title": "%selectTaskCommand%",
        "category": "DualMind"
      },
      {
        "command": "dualMind.alignPanelCenter",
        "title": "%alignPanelCenter%",
        "category": "DualMind"
      }
    ],
    "configuration": {
      "title": "DualMind",
      "properties": {
        "dualMind.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumDescriptions": [
            "%languageAuto%",
            "%languageZh%",
            "%languageEn%"
          ],
          "default": "auto",
          "scope": "application",
          "description": "%language%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dualMind",
          "title": "DualMind",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "dualMind": [
        {
          "id": "dualMind.tasks",
          "name": "%tasksView%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dualMind.newTask",
          "when": "view == dualMind.tasks",
          "group": "navigation"
        },
        {
          "command": "dualMind.alignPanelCenter",
          "when": "view == dualMind.tasks",
          "group": "layout"
        }
      ],
      "commandPalette": [
        {
          "command": "dualMind.selectTask",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-environment.cjs",
    "check:node": "node scripts/check-node.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json && tsc --noEmit -p tests/local/tsconfig.json",
    "lint": "eslint src webview/src tests scripts *.mjs --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run check:env && npm run test:env && npm run test:tools && npm run typecheck && npm run lint && npm run test:local && npm run format:check && npm run docs:check",
    "prebuild": "npm run check:env",
    "build": "npm run tools:prepare && npm run typecheck && node scripts/esbuild.mjs",
    "prewatch": "npm run check:env && npm run tools:prepare",
    "watch": "node scripts/esbuild.mjs --watch",
    "watch:types": "node scripts/watch-types.mjs",
    "compile-tests": "tsc -p tests/tsconfig.json",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "vscode:prepublish": "npm run build",
    "prepackage": "npm run check:env",
    "package": "node scripts/package.mjs",
    "check:env": "node scripts/check-environment.cjs",
    "test:env": "node --test tests/environment.test.cjs",
    "prewatch:types": "npm run check:env",
    "test:local": "node scripts/test-local.mjs",
    "pretest:ui": "npm run build",
    "test:ui": "node scripts/verify-ui.mjs",
    "tools:fetch": "node scripts/bundled-tools.mjs fetch",
    "tools:prepare": "node scripts/bundled-tools.mjs prepare",
    "tools:verify": "node scripts/bundled-tools.mjs verify",
    "test:tools": "node --max-old-space-size=256 --test --test-concurrency=1 tests/tools.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "^17.0.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "Pro-qing",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pro-qing/dual-mind.git"
  },
  "bugs": {
    "url": "https://github.com/Pro-qing/dual-mind/issues"
  },
  "homepage": "https://github.com/Pro-qing/dual-mind#readme",
  "extensionKind": [
    "workspace"
  ],
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "activationEvents": [
    "onWebviewPanel:dualMind.workbench"
  ],
  "icon": "resources/icon.png",
  "preview": true
}
